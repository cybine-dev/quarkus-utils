<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
		http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <property name="json.type" value="JSON"/>
    <property name="uuid.type" value="BINARY(16)" dbms="mariadb"/>
    <property name="uuid.type" value="UUID"/>

    <changeSet id="v0.1.0-customer-setup" author="boelter.fabio">
        <createTable tableName="customer">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="firstname" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="lastname" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="customer">
            <column name="id">1</column>
            <column name="firstname">Bart</column>
            <column name="lastname">Woods</column>
        </insert>
        <insert tableName="customer">
            <column name="id">2</column>
            <column name="firstname">Wilbert</column>
            <column name="lastname">Bray</column>
        </insert>
        <insert tableName="customer">
            <column name="id">3</column>
            <column name="firstname">Allan</column>
            <column name="lastname">Bray</column>
        </insert>
    </changeSet>

    <changeSet id="v0.1.0-library-setup" author="boelter.fabio">
        <createTable tableName="library">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="library">
            <column name="id">1</column>
            <column name="name">Stadtbücherei Bad Mergentheim</column>
            <column name="address">Bahnhofplatz 1, 97980 Bad Mergentheim</column>
        </insert>
        <insert tableName="library">
            <column name="id">2</column>
            <column name="name">Universitätsbibliothek Würzburg</column>
            <column name="address">Hubland Süd, Geb. Z4, Am Hubland, 97074 Würzburg</column>
        </insert>
    </changeSet>

    <changeSet id="v0.1.0-asset-setup" author="boelter.fabio">
        <createTable tableName="asset">
            <column name="id" type="${uuid.type}">
                <constraints primaryKey="true"/>
            </column>
            <column name="external_id" type="VARCHAR(255)"/>
            <column name="library_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
        </createTable>
        <createIndex tableName="asset" indexName="asset-external_id">
            <column name="external_id"/>
        </createIndex>

        <createTable tableName="asset_rental">
            <column name="id" type="${uuid.type}">
                <constraints primaryKey="true"/>
            </column>
            <column name="asset_id" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="begins_at" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="ends_at" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="returned_at" type="DATETIME"/>
        </createTable>

